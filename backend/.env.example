# Database
# Local dev — SQLite (zero config, just works)
DATABASE_URL=sqlite+aiosqlite:///./cloud_ump.db
# Production — swap to PostgreSQL on Supabase / Neon
# DATABASE_URL=postgresql+asyncpg://user:pass@host/cloud_ump

# JWT — run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Hugging Face Inference API
# Free tier: works WITHOUT a token (rate limited to ~30 req/day per IP)
# With free token: 1000 req/day — sign up at https://huggingface.co/join
HF_TOKEN=

# App
APP_NAME=Cloud UMP
DEBUG=true
FRONTEND_URL=http://localhost:5173
